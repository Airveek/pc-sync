# Secrets live in /etc/pc-sync/pc-sync.env on the server (chmod 600),
# never in this file:  PC_SYNC_TOKEN=<hex>  and  PC_SYNC_ADMIN=<hex>
[Unit]
Description=PC-Sync receiver
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=/etc/pc-sync/pc-sync.env
ExecStart=/usr/bin/node /opt/pc-sync/server.cjs
WorkingDirectory=/opt/pc-sync
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
